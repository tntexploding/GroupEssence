# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
.venv.*
venv/
env/

# Packaging output
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.local
/.env.*

# Runtime data. Only the directory policy is versioned.
data/*
!data/README.md

# Logs, backups and temporary exports
*.log
*.bak
*.backup*
*.pot
*.mo

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
