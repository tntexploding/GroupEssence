# SQLite 数据库路径
DB_PATH=./data/group_essence.db

# OneBot HTTP 接口（例如 NapCat / go-cqhttp 兼容服务）
ONEBOT_BASE_URL=http://127.0.0.1:3000
# 访问令牌只填写在本机 .env，切勿提交真实值
ONEBOT_ACCESS_TOKEN=
# 使用 OneBot 采集时必填；OCR-only 模式可以留空
GROUP_ID=

# 是否优先尝试 OneBot 拉取精华
PREFER_ONEBOT=true

# 当 OneBot 失败/无数据时，是否回退 OCR
FALLBACK_OCR=true

# OCR 语言与 Tesseract 路径
OCR_LANG=chi_sim+eng
# 可填写可执行文件路径，也可填写包含该文件的安装目录
TESSERACT_CMD=

# 截图目录（用于 OCR 回退）
SCREENSHOT_DIR=./data/screenshots

# OneBot 图片附件的内容哈希缓存目录
IMAGE_DIR=./data/images
