# SQLite 数据库路径
DB_PATH=./data/group_essence.db

# OneBot HTTP 接口（例如 NapCat / go-cqhttp）
ONEBOT_BASE_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
GROUP_ID=

# 是否优先尝试 OneBot 拉取精华
PREFER_ONEBOT=true

# 当 OneBot 失败/无数据时，是否回退 OCR
FALLBACK_OCR=true

# OCR 语言与 tesseract 路径（Windows 可配置）
OCR_LANG=chi_sim+eng
TESSERACT_CMD=

# 截图目录（用于 OCR 回退）
SCREENSHOT_DIR=./data/screenshots
